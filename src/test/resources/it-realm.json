{
  "realm": "it",
  "enabled": true,
  "sslRequired": "none",
  "eventsListeners": ["openfga-events-publisher", "jboss-logging"],
  "adminEventsEnabled": true,
  "organizationsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "clients": [
    {
      "clientId": "it-admin",
      "secret": "it-admin-secret",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["kc-admin-api", "roles", "basic"]
    },
    {
      "clientId": "openfga-publisher",
      "secret": "openfga-publisher-secret",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["basic"],
      "protocolMappers": [
        {
          "name": "openfga-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "openfga",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-it-admin",
      "enabled": true,
      "serviceAccountClientId": "it-admin",
      "clientRoles": {
        "realm-management": ["realm-admin"]
      }
    }
  ]
}
